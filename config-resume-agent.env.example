# Resume analysis agent configuration
# Copy to: mkdir -p ~/.config/resume-agent && cp config-resume-agent.env.example ~/.config/resume-agent/config.env

# Provider: openai (default) or bedrock
RESUME_AGENT_PROVIDER=openai

# OpenAI / compatible API
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model name (OpenAI examples: gpt-4o-mini, gpt-4o)
RESUME_AGENT_MODEL=gpt-4o-mini

# AWS Bedrock (set RESUME_AGENT_PROVIDER=bedrock)
# RESUME_AGENT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS_REGION=us-east-1

# Generation settings
RESUME_AGENT_TEMPERATURE=0.4
RESUME_AGENT_MAX_TOKENS=2048
