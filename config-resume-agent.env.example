# Resume analysis agent configuration
# Copy to: mkdir -p ~/.config/resume-agent && cp config-resume-agent.env.example ~/.config/resume-agent/config.env

# Provider: anthropic (default) or bedrock
RESUME_AGENT_PROVIDER=anthropic

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model name (examples: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022)
RESUME_AGENT_MODEL=claude-sonnet-4-20250514

# AWS Bedrock (set RESUME_AGENT_PROVIDER=bedrock)
# RESUME_AGENT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS_REGION=us-east-1

# Generation settings (temperature applies to AWS Bedrock provider only)
RESUME_AGENT_TEMPERATURE=0.4
RESUME_AGENT_MAX_TOKENS=2048
