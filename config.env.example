# Local agent configuration (~/.config/job-monitor/config.env)
# Copy to:  mkdir -p ~/.config/job-monitor && cp config.env.example ~/.config/job-monitor/config.env

# How often to check LinkedIn (seconds). Default: 3600 (1 hour)
# JOB_MONITOR_INTERVAL_SECONDS=3600

# Optional: Slack incoming webhook
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Optional: email alerts
# ALERT_EMAIL_TO=you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@example.com

# Optional: override state file location
# JOB_MONITOR_STATE_FILE=/custom/path/seen_jobs.json
